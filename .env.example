# GEMINI_API_KEY: Required for Gemini AI API calls.
# - Trong AI Studio: Tự động nạp từ Secrets panel.
# - Khi triển khai trên Vercel: Cấu hình tại Project Settings -> Environment Variables.
#   Các serverless functions (/api/gemini/suggest-card và /api/gemini/teacher-comment)
#   sẽ đọc biến này ở phía máy chủ an toàn, không lộ ra client.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

